{
  "name": "d20-web",
  "version": "1.0.0",
  "private": true,
  "description": "D20 角色构筑器 · Cordis 式浏览器扩展（TypeScript 移植，参考 deepseek-harness 架构）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"try{require('child_process').execSync('rmdir /s /q dist 2>nul',{stdio:'ignore'})}catch(e){}\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsc -p tsconfig.smoke.json && node smoke.cjs",
    "test:build": "tsc -p tsconfig.smoke.json",
    "test": "npm run test:build && node --test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
